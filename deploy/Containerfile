FROM docker.io/library/node:24-alpine

ENV NODE_ENV=production
ENV DATA_DIR=/data
ENV PORT=3000
ENV BIND_HOST=0.0.0.0
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY web ./web

# The process owns only its persistent volume. It never needs root, additional
# Linux capabilities, or write access to the application files.
RUN addgroup -g 10010 appgroup \
    && adduser -u 10010 -G appgroup -s /sbin/nologin -D appuser \
    && mkdir -p /data \
    && chown -R 10010:10010 /data

USER 10010:10010
VOLUME ["/data"]
EXPOSE 3000

CMD ["node", "server/index.js"]
