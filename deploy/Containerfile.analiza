# The analysis service: photograph in, source mask out.
#
# Separate from the Node image on purpose. It carries a 16 MB model and a
# 480 MB scientific stack that the web server has no use for, and it is the
# part most likely to be rebuilt while the rest stays still.
FROM docker.io/library/python:3.11-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 MPLCONFIGDIR=/tmp/matplotlib

# MediaPipe links against the graphics libraries even when it runs on the CPU:
# without them the import fails with "libEGL.so.1: cannot open shared object".
# OpenCV 5 additionally needs glib, even in the headless build -- the failure
# there is "libgthread-2.0.so.0", which reads like a threading problem and is
# really a missing package.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends \
      libegl1 libgles2 libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY analiza/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
 && python -c "import cv2, mediapipe, numpy; print('import ok')"

# The model is part of the image, not a runtime download: an image that fetches
# its own weights on boot is not reproducible and fails when the network does.
COPY models ./models
COPY analiza ./analiza

RUN useradd --system --uid 10012 --no-create-home appuser
USER 10012
ENV MODEL_DIR=/app/models PYTHONPATH=/app/analiza
EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "warning"]
