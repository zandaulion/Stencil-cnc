# Copy to ~/.config/stencil-cnc/stencil-cnc.env with mode 0600.
# Never commit the real file.

PUBLIC_BASE_URL=https://stencil-cnc.zandaulion.com

# Generate with: openssl rand -hex 32
# Copy the same value into STENCIL_CNC_ADMIN_TOKEN in Caddy's protected
# EnvironmentFile. A missing value fails closed: no admin request is accepted.
ADMIN_TOKEN=

INVITE_TTL_DAYS=7
# During this absolute window a second redemption rotates the SAME device's
# token. It covers moving from a chat browser to the installed PWA.
INVITE_REBIND_MINUTES=60

# Trust Cloudflare/Caddy's client address only because the container port is
# published on loopback and cannot be reached around those proxies.
TRUST_PROXY_HEADERS=true
REDEEM_MAX_FAILURES_PER_MINUTE=8
REDEEM_MAX_FAILURES_GLOBAL_PER_MINUTE=120

DATA_DIR=/data
PORT=3000
BIND_HOST=0.0.0.0
