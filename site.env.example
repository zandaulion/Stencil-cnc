# Copy to ~/.config/stencil-cnc/stencil-cnc.env with mode 0600.
# Never commit the real file.

PUBLIC_BASE_URL=https://stencil-cnc.zandaulion.com

# Generate with: openssl rand -hex 32
# Copy the same value into STENCIL_CNC_ADMIN_TOKEN in Caddy's protected
# EnvironmentFile. A missing value fails closed: no admin request is accepted.
ADMIN_TOKEN=

# Optional dedicated encryption key for server-hosted project shares.
# Generate with: openssl rand -hex 32
# If omitted, a domain-separated key is derived from ADMIN_TOKEN. Changing
# whichever value is active makes previously shared packages unreadable.
SHARE_ENCRYPTION_KEY=
SHARE_MAX_BYTES=67108864
SHARE_OWNER_MAX_BYTES=536870912
SHARE_OWNER_MAX_ACTIVE=50

# Optional dedicated key for canonical server projects. Generate with:
# openssl rand -hex 32
# If omitted, Kerfloom derives a separate domain key from SHARE_ENCRYPTION_KEY
# or ADMIN_TOKEN. Keep the active key in encrypted backups: losing it makes
# stored projects unreadable by design.
PROJECT_ENCRYPTION_KEY=
# Non-secret identifier stored beside each encrypted project revision. Change
# it whenever PROJECT_ENCRYPTION_KEY changes; never reuse an ID for new bytes.
PROJECT_ENCRYPTION_KEY_ID=
# During a staged rotation, retain old ID=secret pairs separated by commas.
# Remove an old key only after the migration command reports zero failures and
# the backup/restore drill succeeds with the new key set.
PROJECT_PREVIOUS_ENCRYPTION_KEYS=
PROJECT_MAX_BYTES=134217728
PROJECT_WORKSPACE_MAX_BYTES=2147483648

INVITE_TTL_DAYS=7
# During this absolute window a second redemption rotates the SAME device's
# token. It covers moving from a chat browser to the installed PWA.
INVITE_REBIND_MINUTES=60

# Trust Cloudflare/Caddy's client address only because the container port is
# published on loopback and cannot be reached around those proxies.
TRUST_PROXY_HEADERS=true
REDEEM_MAX_FAILURES_PER_MINUTE=8
REDEEM_MAX_FAILURES_GLOBAL_PER_MINUTE=120

DATA_DIR=/data
PORT=3000
BIND_HOST=0.0.0.0
